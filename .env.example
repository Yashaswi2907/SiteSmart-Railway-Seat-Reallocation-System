# Copy this file to .env and adjust values. Never commit your real .env file.

# --- Django core -----------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Needed only when serving over a custom domain, e.g. https://demo.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
# Set to True when serving over HTTPS
DJANGO_SECURE_COOKIES=False
SESSION_COOKIE_AGE=28800

# --- Database --------------------------------------------------------------
# SQLite file name, relative to the project folder
SQLITE_PATH=db.sqlite3

# --- Application -----------------------------------------------------------
ADVANCE_BOOKING_DAYS=120
# Seconds between automatic simulation steps when "Auto-run" is enabled
SIMULATION_DEFAULT_INTERVAL=20
API_USER_THROTTLE=600/minute
APP_LOG_LEVEL=INFO

# --- Demo data -------------------------------------------------------------
# Password given to every fictional demo account created by `manage.py seed_demo`
DEMO_PASSWORD=Demo@12345
